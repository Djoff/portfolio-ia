# En-têtes de sécurité et redirections (Apache, hébergement web Infomaniak).
# À vérifier une fois en ligne (phase 2) : securityheaders.com et Mozilla Observatory.

Options -Indexes

<IfModule mod_headers.c>
  # Aucun script, aucune ressource externe : uniquement la feuille de style et les images du site.
  Header always set Content-Security-Policy "default-src 'none'; style-src 'self'; img-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
  # HTTPS obligatoire pendant un an (préchargement HSTS : à décider plus tard).
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  # La redirection de la racine dépend de la langue : les caches doivent le savoir.
  Header always append Vary Accept-Language env=VARY_LANG
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()"
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On

  # HTTP → HTTPS
  RewriteCond %{HTTPS} !=on
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

  # Racine : version anglaise si le navigateur la préfère, sinon française.
  RewriteCond %{HTTP:Accept-Language} ^en [NC]
  RewriteRule ^$ /en/ [R=302,L,E=VARY_LANG:1]
  RewriteRule ^$ /fr/ [R=302,L,E=VARY_LANG:1]
</IfModule>
